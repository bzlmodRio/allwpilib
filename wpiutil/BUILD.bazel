load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")
load("//wpiutil:generate.bzl", "generate_wpiutil")

py_binary(
    name = "generate_nanopb",
    srcs = ["generate_nanopb.py"],
    data = [
        ":nanopb_generator",
    ],
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//:generation",
    ],
)

filegroup(
    name = "proto_files",
    srcs = glob(["src/test/proto/*.proto"]),
)

generate_wpiutil(
    name = "generate_wpiutil",
    proto_files = ":proto_files",
)

write_source_files(
    name = "write_wpiutil",
    diff_args = ["-u"],
    files = {
        "src/generated/test": ":generate_wpiutil",
    },
    suggested_update_target = "//:write_all",
    tags = ["pregeneration"],
    visibility = ["//visibility:public"],
)

# The generated test sources live outside //wpiutil/src/test/native, so they are
# bridged into that package from here.
filegroup(
    name = "generated-test-native-srcs",
    srcs = glob(["src/generated/test/native/cpp/*"]),
    visibility = ["//wpiutil/src/test/native:__pkg__"],
)

cc_library(
    name = "nanopb-test-headers",
    hdrs = glob(["src/generated/test/native/include/*.npb.h"]),
    strip_include_prefix = "src/generated/test/native/include",
    visibility = ["//wpiutil/src/test/native:__pkg__"],
)

# Back-compat aliases for targets that moved to //wpiutil/src/main/native.

alias(
    name = "wpiutil",
    actual = "//wpiutil/src/main/native:wpiutil",
    visibility = ["//visibility:public"],
)

alias(
    name = "nanopb_generator",
    actual = "//wpiutil/src/main/native:nanopb_generator",
    visibility = ["//visibility:public"],
)
