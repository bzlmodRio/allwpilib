load("@allwpilib_pip_deps//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")
load("//shared/bazel/rules:cc_rules.bzl", "third_party_cc_lib_helper", "wpilib_cc_library", "wpilib_cc_shared_library", "wpilib_cc_static_library")
load("//shared/bazel/rules:jni_rules.bzl", "wpilib_jni_cc_library")
load("//shared/bazel/rules:packaging.bzl", "package_default_jni_project")
load("//shared/bazel/rules/gen:gen-resources.bzl", "generate_resources")
load("//shared/bazel/rules/robotpy:build_info_gen.bzl", "generate_robotpy_native_wrapper_build_info")
load("//wpiutil/src/main/native:robotpy_build_info.bzl", "define_native_wrapper")

filegroup(
    name = "doxygen-files",
    srcs = glob([
        "include/**/*",
        "thirdparty/argparse/include/**/*",
        "thirdparty/debugging/include/**/*",
        "thirdparty/double-conversion/include/**/*",
        "thirdparty/htrie/include/**/*",
        "thirdparty/json/include/**/*",
        "thirdparty/llvm/include/**/*",
        "thirdparty/mpack/include/**/*",
        "thirdparty/nanopb/include/**/*",
        "thirdparty/sigslot/include/**/*",
    ]),
    visibility = ["//visibility:public"],
)

exports_files(["resources/wpilib-128.png"])

py_binary(
    name = "nanopb_generator",
    srcs = glob(["thirdparty/nanopb/generator/**/*.py"]),
    data = ["thirdparty/nanopb/generator/proto/nanopb.proto"],
    imports = ["thirdparty/nanopb/generator"],
    target_compatible_with = select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        requirement("protobuf"),
        requirement("grpcio-tools"),
    ],
)

third_party_cc_lib_helper(
    name = "argparse",
    include_root = "thirdparty/argparse/include",
    src_root = None,
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "debugging",
    include_root = "thirdparty/debugging/include",
    src_root = "thirdparty/debugging/src",
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "double-conversion",
    include_root = "thirdparty/double-conversion/include",
    src_root = "thirdparty/double-conversion/src",
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "json",
    include_root = "thirdparty/json/include",
    src_root = "thirdparty/json/src",
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "htrie",
    include_root = "thirdparty/htrie/include",
)

third_party_cc_lib_helper(
    name = "llvm",
    include_root = "thirdparty/llvm/include",
    src_root = "thirdparty/llvm/cpp",
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "mpack",
    include_root = "thirdparty/mpack/include",
    src_root = "thirdparty/mpack/src",
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "nanopb",
    include_root = "thirdparty/nanopb/include",
    src_root = "thirdparty/nanopb/src",
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "sigslot",
    include_root = "thirdparty/sigslot/include",
    visibility = ["//visibility:public"],
)

third_party_cc_lib_helper(
    name = "upb",
    include_root = "thirdparty/upb/include",
    src_root = "thirdparty/upb/src",
    visibility = ["//visibility:public"],
)

generate_resources(
    name = "generate-resources",
    namespace = "wpi",
    prefix = "WPI",
    resource_files = glob(["resources/*"]),
)

filegroup(
    name = "native-srcs",
    srcs = select({
        "@platforms//os:windows": glob(["windows/*.cpp"]),
        "@wpilib_toolchains//constraints/combined:is_unix": glob(["unix/*.cpp"]),
    }),
)

wpilib_cc_library(
    name = "wpiutil",
    srcs = glob(
        ["cpp/**"],
        exclude = ["cpp/jni/**"],
    ) + [
        ":generate-resources",
        ":native-srcs",
    ],
    hdrs = glob(["include/**/*"]),
    extra_src_pkg_files = ["//wpiutil/src/main/java:wpiutil-java-jni-hdrs-pkg"],
    includes = ["include"],
    strip_include_prefix = "include",
    third_party_header_only_libraries = [
        ":argparse",
        ":htrie",
        ":sigslot",
    ],
    third_party_libraries = [
        ":debugging",
        ":double-conversion",
        ":json",
        ":llvm",
        ":mpack",
        ":nanopb",
        ":upb",
    ],
    visibility = ["//visibility:public"],
    deps = select({
        "//conditions:default": [],
    }),
)

wpilib_cc_shared_library(
    name = "shared/wpiutil",
    visibility = ["//visibility:public"],
    deps = [
        ":wpiutil",
    ],
)

wpilib_cc_static_library(
    name = "static/wpiutil",
    visibility = ["//visibility:public"],
    deps = [
        ":wpiutil",
    ],
)

cc_library(
    name = "wpiutil-jni-hdrs",
    hdrs = glob([
        "include/**",
        "thirdparty/llvm/include/**",
    ]),
    includes = [
        "include",
        "thirdparty/llvm/include",
    ],
)

wpilib_jni_cc_library(
    name = "wpiutiljni",
    srcs = glob(["cpp/jni/**"]),
    java_dep = "//wpiutil/src/main/java:wpiutil-java",
    visibility = ["//visibility:public"],
    deps = [
        ":wpiutil",
    ],
)

wpilib_cc_shared_library(
    name = "shared/wpiutiljni",
    auto_export_windows_symbols = False,
    dynamic_deps = [
        ":shared/wpiutil",
    ],
    use_debug_name = False,
    visibility = ["//visibility:public"],
    deps = [":wpiutiljni"],
)

wpilib_cc_static_library(
    name = "static/wpiutiljni",
    static_deps = [
        ":static/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":wpiutiljni",
    ],
)

generate_robotpy_native_wrapper_build_info(
    name = "robotpy-native-wpiutil-generator",
    pyproject_toml = "pyproject.toml",
    third_party_dirs = [
        "argparse",
        "debugging",
        "double-conversion",
        "htrie",
        "json",
        "llvm",
        "mpack",
        "nanopb",
        "sigslot",
        "upb",
    ],
)

define_native_wrapper(
    name = "robotpy-native-wpiutil",
)

package_default_jni_project(
    name = "wpiutil",
    maven_artifact_name = "wpiutil-cpp",
    maven_group_id = "org.wpilib.wpiutil",
)
