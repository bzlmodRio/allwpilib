load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//shared/bazel/rules:packaging.bzl", "package_binary_cc_project")
load("//shared/bazel/rules/gen:gen-resources.bzl", "generate_resources")
load("//thirdparty/imgui_suite/imgui_test_engine:imgui_test.bzl", "imgui_test_target_compatible_with")

generate_resources(
    name = "generate-resources",
    namespace = "sysid",
    prefix = "SYSID",
    resource_files = glob(["resources/*"]),
)

SYSID_SRCS = glob(
    ["cpp/**/*.cpp"],
    exclude = ["cpp/Main.cpp"],
) + [
    ":generate-resources",
    "//tools/sysid:generate-version",
]

cc_library(
    name = "sysid-lib",
    srcs = SYSID_SRCS,
    hdrs = glob(["include/**"]),
    strip_include_prefix = "include",
    visibility = ["//tools/sysid/src/test/native:__pkg__"],
    deps = [
        "//datalog/src/main/native:datalog",
        "//glass",
        "//wpinet/src/main/native:wpinet",
    ],
)

cc_binary(
    name = "sysid",
    srcs = ["cpp/Main.cpp"],
    linkopts = select({
        "@platforms//os:windows": ["-SUBSYSTEM:WINDOWS"],
        "//conditions:default": [],
    }),
    deps = ["sysid-lib"],
)

cc_library(
    name = "sysid_lib_for_tests",
    testonly = True,
    srcs = SYSID_SRCS,
    hdrs = glob(["include/**"]),
    defines = ["RUNNING_IMGUI_TESTS"],
    strip_include_prefix = "include",
    target_compatible_with = imgui_test_target_compatible_with(),
    visibility = ["//tools/sysid/src/test/native/imgui:__pkg__"],
    deps = [
        "//datalog/src/main/native:datalog",
        "//glass",
        "//wpigui/src/test/native",
        "//wpinet/src/main/native:wpinet",
    ],
)

package_binary_cc_project(
    name = "sysid",
    maven_artifact_name = "SysId",
    maven_group_id = "org.wpilib.tools",
)
