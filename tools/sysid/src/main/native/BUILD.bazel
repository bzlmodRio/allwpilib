load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//shared/bazel/rules:packaging.bzl", "package_binary_cc_project")
load("//shared/bazel/rules/gen:gen-resources.bzl", "generate_resources")

generate_resources(
    name = "generate-resources",
    namespace = "sysid",
    prefix = "SYSID",
    resource_files = glob(["resources/*"]),
)

cc_library(
    name = "sysid-lib",
    srcs = glob(
        ["cpp/**/*.cpp"],
        exclude = ["cpp/Main.cpp"],
    ) + [
        ":generate-resources",
        "//tools/sysid:generate-version",
    ],
    hdrs = glob(["include/**"]),
    strip_include_prefix = "include",
    visibility = ["//tools/sysid:__subpackages__"],
    deps = [
        "//datalog/src/main/native:datalog",
        "//glass",
        "//wpinet/src/main/native:wpinet",
    ],
)

cc_binary(
    name = "sysid",
    srcs = ["cpp/Main.cpp"],
    linkopts = select({
        "@platforms//os:windows": ["-SUBSYSTEM:WINDOWS"],
        "//conditions:default": [],
    }),
    deps = ["sysid-lib"],
)

package_binary_cc_project(
    name = "sysid",
    maven_artifact_name = "SysId",
    maven_group_id = "org.wpilib.tools",
)
