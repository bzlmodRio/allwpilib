load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//shared/bazel/rules:cc_rules.bzl", "wpilib_cc_library")
load("//shared/bazel/rules:imgui_test.bzl", "imgui_test_target_compatible_with")
load("//shared/bazel/rules:packaging.bzl", "package_binary_cc_project")
load("//shared/bazel/rules/gen:gen-resources.bzl", "generate_resources")
load("//tools/wpical:copts.bzl", "COPTS", "CXXOPTS", "LINKOPTS")

filegroup(
    name = "test-assets",
    srcs = glob(["assets/**"]) + [
        "assets",
        "assets/altfieldvideo",
        "assets/fieldvideo",
    ],
    visibility = ["//tools/wpical/src/test/native:__pkg__"],
)

filegroup(
    name = "wpical-main-cpp",
    srcs = ["cpp/WPIcal.cpp"],
    visibility = ["//tools/wpical/src/test/native/imgui:__pkg__"],
)

generate_resources(
    name = "generate-resources",
    namespace = "wpical",
    prefix = "WPI",
    resource_files = glob(["resources/*"]),
)

cc_library(
    name = "headers",
    hdrs = glob([
        "include/**/*",
    ]),
    strip_include_prefix = "include",
    deps = [
        ":headers-libdogleg",
        ":headers-mrcal",
        ":headers-mrcal-generated",
        ":headers-mrcal-java",
    ],
)

cc_library(
    name = "headers-libdogleg",
    hdrs = glob([
        "thirdparty/libdogleg/include/**/*",
    ]),
    strip_include_prefix = "thirdparty/libdogleg/include",
)

cc_library(
    name = "headers-mrcal-generated",
    hdrs = glob([
        "thirdparty/mrcal/generated/**/*",
    ]),
    strip_include_prefix = "thirdparty/mrcal/generated/",
)

cc_library(
    name = "headers-mrcal",
    hdrs = glob([
        "thirdparty/mrcal/include/**/*",
    ]),
    strip_include_prefix = "thirdparty/mrcal/include/",
)

cc_library(
    name = "headers-mrcal-java",
    hdrs = glob([
        "thirdparty/mrcal_java/include/**/*",
    ]),
    strip_include_prefix = "thirdparty/mrcal_java/include/",
)

wpilib_cc_library(
    name = "wpical_lib",
    srcs = glob(
        [
            "cpp/**/*.cpp",
            "thirdparty/libdogleg/src/**/*.c",
            "thirdparty/mrcal/src/**/*.cpp",
            "thirdparty/mrcal/src/**/*.c",
            "thirdparty/mrcal_java/src/**/*.cpp",
        ],
        exclude = ["cpp/WPIcal.cpp"],
    ) + [
        ":generate-resources",
        "//tools/wpical:generate-version",
    ],
    copts = COPTS,
    cxxopts = CXXOPTS,
    defines = ["OPENCV_DISABLE_EIGEN_TENSOR_SUPPORT"],
    hdrs_pkg_root = "include",
    linkopts = LINKOPTS,
    linkstatic = True,
    srcs_pkg_root = "cpp",
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        "//apriltag",
        "//fields",
        "//shared/bazel/thirdparty/ceres",
        "//wpigui",
        "//wpiutil",
        "@bzlmodrio-opencv//libraries/cpp/opencv",
    ],
)

alias(
    name = "native",
    actual = ":wpical_lib",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "wpical_lib_for_tests",
    testonly = True,
    srcs = glob(
        [
            "cpp/**/*.cpp",
            "thirdparty/libdogleg/src/**/*.c",
            "thirdparty/mrcal/src/**/*.cpp",
            "thirdparty/mrcal/src/**/*.c",
            "thirdparty/mrcal_java/src/**/*.cpp",
        ],
        exclude = ["cpp/WPIcal.cpp"],
    ) + [
        ":generate-resources",
        "//tools/wpical:generate-version",
    ],
    copts = COPTS,
    cxxopts = CXXOPTS,
    defines = ["OPENCV_DISABLE_EIGEN_TENSOR_SUPPORT"],
    linkopts = LINKOPTS,
    linkstatic = True,
    target_compatible_with = imgui_test_target_compatible_with(),
    visibility = ["//tools/wpical/src/test/native/imgui:__pkg__"],
    deps = [
        ":headers",
        "//apriltag",
        "//fields",
        "//shared/bazel/thirdparty/ceres",
        "//wpigui:wpigui_for_tests",
        "//wpiutil",
        "@bzlmodrio-opencv//libraries/cpp/opencv",
    ],
)

cc_binary(
    name = "wpical",
    srcs = [
        "cpp/WPIcal.cpp",
    ],
    copts = COPTS,
    cxxopts = CXXOPTS,
    linkopts = select({
        "@platforms//os:linux": [],
        "@platforms//os:osx": [],
        "@platforms//os:windows": [
            "-SUBSYSTEM:WINDOWS",
        ],
    }),
    deps = [
        ":wpical_lib",
        "//glass",
        "//thirdparty/imgui_suite",
    ],
)

package_binary_cc_project(
    name = "wpical",
    extra_files = ["//tools/wpical:licenses"],
    maven_artifact_name = "wpical",
    maven_group_id = "org.wpilib.tools",
)
