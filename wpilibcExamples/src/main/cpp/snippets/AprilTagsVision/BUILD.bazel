load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

filegroup(
    name = "sources",
    srcs = glob(["cpp/**/*.cpp"]),
    visibility = [
        "//wpilibcExamples/src/main/cpp/snippets:__pkg__",
    ],
)

cc_binary(
    name = "AprilTagsVision",
    srcs = [":sources"],
    tags = [
        "wpi-example",
    ],
    deps = [
        "//apriltag/src/main/native:apriltag",
        "//cameraserver/src/main/native:cameraserver",
        "//ntcore/src/main/native:ntcore",
        "//wpilibc/src/main/native:wpilibc",
        "//wpimath/src/main/native:wpimath",
    ],
)
