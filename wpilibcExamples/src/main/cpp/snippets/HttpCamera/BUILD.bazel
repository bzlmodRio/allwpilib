load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

filegroup(
    name = "sources",
    srcs = glob(["cpp/**/*.cpp"]),
    visibility = [
        "//wpilibcExamples/src/main/cpp/snippets:__pkg__",
    ],
)

cc_binary(
    name = "HttpCamera",
    srcs = [":sources"],
    tags = [
        "wpi-example",
    ],
    deps = [
        "//cameraserver/src/main/native:cameraserver",
        "//cscore/src/main/native:cscore",
        "//wpilibc/src/main/native:wpilibc",
    ],
)
