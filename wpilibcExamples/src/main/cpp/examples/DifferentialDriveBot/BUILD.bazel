load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

filegroup(
    name = "sources",
    srcs = glob([
        "cpp/**/*.cpp",
        "include/**/*.hpp",
    ]),
    visibility = [
        "//wpilibcExamples/src/main/cpp/examples:__pkg__",
    ],
)

cc_binary(
    name = "DifferentialDriveBot",
    srcs = [":sources"],
    includes = ["include"],
    tags = [
        "wpi-example",
    ],
    deps = [
        "//drivers/src/main/native:drivers",
        "//wpilibc/src/main/native:wpilibc",
        "//wpimath/src/main/native:wpimath",
    ],
)
