load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "netconsoleServer",
    srcs = ["src/netconsoleServer/native/cpp/main.cpp"],
    linkopts = select({
        "@platforms//os:linux": ["-lutil"],
        "//conditions:default": [],
    }),
    deps = [
        ":wpinet",
    ],
)

cc_binary(
    name = "netconsoleTee",
    srcs = ["src/netconsoleTee/native/cpp/main.cpp"],
    deps = [
        ":wpinet",
    ],
)

# Back-compat aliases for targets that moved to //wpinet/src/main/native.

alias(
    name = "wpinet",
    actual = "//wpinet/src/main/native:wpinet",
    visibility = ["//visibility:public"],
)
