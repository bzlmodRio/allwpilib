load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//:mappings.bzl", "pkg_files")
load("//shared/bazel/rules:cc_rules.bzl", "third_party_cc_lib_helper", "wpilib_cc_library", "wpilib_cc_shared_library", "wpilib_cc_static_library")
load("//shared/bazel/rules:jni_rules.bzl", "wpilib_jni_cc_library")
load("//shared/bazel/rules:objectivec_rules.bzl", "wpilib_objc_library")
load("//shared/bazel/rules:packaging.bzl", "package_default_jni_project")
load("//shared/bazel/rules/robotpy:build_info_gen.bzl", "generate_robotpy_native_wrapper_build_info")
load(":robotpy_native_build_info.bzl", "define_native_wrapper")

filegroup(
    name = "doxygen-files",
    srcs = glob([
        "include/**/*",
        "thirdparty/ada/include/**/*",
        "thirdparty/tcpsockets/include/**/*",
    ]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ada-headers",
    hdrs = glob([
        "thirdparty/ada/include/**/*.h",
    ]),
    includes = ["thirdparty/ada/src"],
    strip_include_prefix = "thirdparty/ada/include",
)

cc_library(
    name = "ada",
    srcs = ["thirdparty/ada/src/ada.cpp"],
    hdrs = glob([
        "thirdparty/ada/src/**/*.cpp",
    ]),
    strip_include_prefix = "thirdparty/ada/src",
    visibility = ["//wpinet:__subpackages__"],
    deps = [":ada-headers"],
)

pkg_files(
    name = "thirdparty-ada-hdr-pkg",
    srcs = glob(["thirdparty/ada/include/**"]),
    strip_prefix = "thirdparty/ada/include",
)

pkg_files(
    name = "thirdparty-ada-src-pkg",
    srcs = glob(["thirdparty/ada/src/**"]),
    strip_prefix = "thirdparty/ada/src",
)

pkg_files(
    name = "thirdparty-libuv-hdr-pkg",
    srcs = ["@libuv//:include_files"],
    strip_prefix = "include",
)

pkg_files(
    name = "thirdparty-libuv-src-pkg",
    srcs = ["@libuv//:src_files"],
    strip_prefix = "src",
)

third_party_cc_lib_helper(
    name = "llhttp",
    include_root = "thirdparty/llhttp/include",
    src_root = "thirdparty/llhttp/src",
)

third_party_cc_lib_helper(
    name = "tcpsockets",
    include_root = "thirdparty/tcpsockets/include",
    src_root = "thirdparty/tcpsockets/cpp",
)

filegroup(
    name = "native-srcs",
    srcs = select({
        "@platforms//os:linux": glob(["linux/*"]),
        "@platforms//os:osx": glob(["macOS/*.cpp"]),
        "@platforms//os:windows": glob(["windows/*"]),
    }),
)

wpilib_objc_library(
    name = "wpinet-mac-bluetooth",
    srcs = glob(["macOS/**/*.mm"]),
    hdrs = glob(["include/**/*"]),
    includes = [
        "include",
    ],
    sdk_frameworks = [
        "CoreBluetooth",
        "Foundation",
    ],
    deps = [
        "//wpiutil",
        "@libuv",
    ],
)

cc_library(
    name = "private_includes",
    hdrs = glob([
        "cpp/*.hpp",
    ]),
    strip_include_prefix = "cpp",
)

wpilib_cc_library(
    name = "wpinet",
    srcs = glob(
        ["cpp/**"],
        exclude = ["cpp/jni/**"],
    ) + ["native-srcs"],
    hdrs = glob(["include/**/*"]),
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": [],
        "//conditions:default": [
            "-Wno-error=pedantic",
            "-Wno-error=format",
        ],
    }),
    extra_hdr_pkg_files = [
        ":thirdparty-ada-hdr-pkg",
        ":thirdparty-libuv-hdr-pkg",
    ],
    extra_src_pkg_files = [
        ":thirdparty-ada-src-pkg",
        ":thirdparty-libuv-src-pkg",
        "//wpinet/src/main/java:wpinet-java-jni-hdrs-pkg",
    ],
    hdrs_pkg_root = "include",
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,--push-state,-as-needed",
            "-ldl",
            "-Wl,--pop-state",
        ],
        "@platforms//os:windows": [
            "windowsapp.lib",
        ],
        "//conditions:default": [],
    }),
    srcs_pkg_root = "cpp",
    strip_include_prefix = "include",
    third_party_libraries = [
        ":llhttp",
        ":tcpsockets",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":ada",
        ":private_includes",
        "//wpiutil",
        "@libuv",
    ] + select({
        "@platforms//os:osx": [":wpinet-mac-bluetooth"],
        "//conditions:default": [],
    }),
)

sdk_framework_flags = [
    "-framework",
    "CoreBluetooth",
    "-framework",
    "Foundation",
]

alias(
    name = "native",
    actual = ":wpinet",
    visibility = ["//visibility:public"],
)

wpilib_cc_shared_library(
    name = "shared/wpinet",
    additional_linker_inputs = select({
        "@platforms//os:osx": [":wpinet-mac-bluetooth"],
        "//conditions:default": [],
    }),
    dynamic_deps = [
        "//wpiutil:shared/wpiutil",
    ],
    user_link_flags = select({
        "@platforms//os:osx": [
            "-Wl,-force_load,$(location :wpinet-mac-bluetooth)",
        ] + sdk_framework_flags,
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":wpinet",
    ],
)

wpilib_cc_static_library(
    name = "static/wpinet",
    static_deps = [
        "//wpiutil:static/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":wpinet",
    ],
)

wpilib_jni_cc_library(
    name = "wpinetjni",
    srcs = glob([
        "cpp/jni/**",
        "cpp/**/*.hpp",
    ]),
    java_dep = "//wpinet/src/main/java:wpinet-java",
    visibility = ["//visibility:public"],
    deps = [
        ":wpinet",
    ],
)

wpilib_cc_shared_library(
    name = "shared/wpinetjni",
    auto_export_windows_symbols = False,
    dynamic_deps = [
        "//wpiutil:shared/wpiutil",
        ":shared/wpinet",
    ],
    use_debug_name = False,
    visibility = ["//visibility:public"],
    deps = [":wpinetjni"],
)

generate_robotpy_native_wrapper_build_info(
    name = "robotpy-native-wpinet-generator",
    module_include_targets = {
        "@libuv//:include_files": "include",
    },
    native_srcs_root = "",
    pyproject_toml = "pyproject.toml",
    third_party_dirs = [
        "ada",
        "llhttp",
        "tcpsockets",
    ],
)

define_native_wrapper(
    name = "robotpy-native-wpinet",
    pyproject_toml = "pyproject.toml",
)

package_default_jni_project(
    name = "wpinet",
    maven_artifact_name = "wpinet-cpp",
    maven_group_id = "org.wpilib.wpinet",
)
