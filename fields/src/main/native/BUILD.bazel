load("@rules_pkg//:mappings.bzl", "pkg_files")
load("//fields/src/main/native:robotpy_build_info.bzl", "define_native_wrapper")
load("//shared/bazel/rules:cc_rules.bzl", "wpilib_cc_library", "wpilib_cc_shared_library", "wpilib_cc_static_library")
load("//shared/bazel/rules:packaging.bzl", "package_default_cc_project", "package_static_cc_project")
load("//shared/bazel/rules:publishing.bzl", "host_architectures")
load("//shared/bazel/rules/gen:gen-resources.bzl", "generate_resources")
load("//shared/bazel/rules/robotpy:build_info_gen.bzl", "generate_robotpy_native_wrapper_build_info")

FIELD_JSONS = glob(["resources/**/*.json"])

FIELD_IMAGES = glob(
    [
        "resources/**/*.jpg",
        "resources/**/*.png",
    ],
)

filegroup(
    name = "doxygen-files",
    srcs = glob([
        "include/**/*",
    ]) + ["//fields:generated-native-include-files"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "field-jsons",
    srcs = FIELD_JSONS,
    visibility = ["//fields:__subpackages__"],
)

generate_resources(
    name = "generate-image-resources",
    namespace = "wpi::fields",
    prefix = "FIELD_IMAGES",
    resource_files = FIELD_IMAGES,
)

generate_resources(
    name = "generate-resources",
    namespace = "wpi::fields",
    prefix = "FIELDS",
    resource_files = FIELD_JSONS,
)

pkg_files(
    name = "field-handwritten-srcs-pkg",
    srcs = [
        "cpp/Field.cpp",
        "cpp/FieldImage.cpp",
        "cpp/FieldTag.cpp",
    ],
)

pkg_files(
    name = "field-image-resource-srcs-pkg",
    srcs = [":generate-image-resources"],
)

pkg_files(
    name = "resources",
    srcs = FIELD_JSONS,
    strip_prefix = "resources/",
    visibility = ["//fields:__subpackages__"],
)

pkg_files(
    name = "field-resource-srcs-pkg",
    srcs = [":generate-resources"],
)

wpilib_cc_library(
    name = "fields",
    srcs = [":generate-resources"] + [
        "cpp/Field.cpp",
        "cpp/FieldImage.cpp",
        "cpp/FieldTag.cpp",
        "//fields:src/generated/main/native/cpp/fields/fields.cpp",
    ],
    hdrs = glob(["include/**/*"]),
    extra_src_pkg_files = [
        ":field-handwritten-srcs-pkg",
        ":field-resource-srcs-pkg",
    ],
    include_license_files = True,
    local_defines = ["WPILIB_EXPORTS"],
    strip_include_prefix = "include",
    third_party_header_only_libraries = [
        "//fields:generated_cc",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//wpimath/src/main/native:wpimath",
        "//wpiutil/src/main/native:wpiutil",
    ],
)

wpilib_cc_shared_library(
    name = "shared/fields",
    dynamic_deps = [
        "//telemetry/src/main/native:shared/telemetry",
        "//tunables/src/main/native:shared/tunables",
        "//wpimath/src/main/native:shared/wpimath",
        "//wpiutil/src/main/native:shared/wpiutil",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":fields",
    ],
)

wpilib_cc_static_library(
    name = "static/fields",
    static_deps = [
        "//telemetry/src/main/native:static/telemetry",
        "//tunables/src/main/native:static/tunables",
        "//wpimath/src/main/native:static/wpimath",
        "//wpiutil/src/main/native:static/wpiutil",
    ],
    static_lib_name = select({
        "@platforms//os:windows": "static/fields.lib",
        "//conditions:default": "static/libfields.a",
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":fields",
    ],
)

generate_robotpy_native_wrapper_build_info(
    name = "robotpy-native-fields-generator",
    generated_include_target = "//fields:generated-native-include-files",
    pyproject_toml = "pyproject.toml",
)

define_native_wrapper(
    name = "robotpy-native-fields",
    pyproject_toml = "pyproject.toml",
)

NO_SYSTEMCORE = select({
    "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

wpilib_cc_library(
    name = "fieldimages",
    srcs = [":generate-image-resources"] + [
        "//fields:src/generated/main/native/cpp/fieldimages/field_images.cpp",
    ],
    hdrs = glob(["include/**/*"]),
    extra_src_pkg_files = [
        ":field-image-resource-srcs-pkg",
    ],
    include_license_files = True,
    local_defines = ["WPILIB_EXPORTS"],
    strip_include_prefix = "include",
    target_compatible_with = NO_SYSTEMCORE,
    visibility = ["//visibility:public"],
    deps = [
        "//wpiutil/src/main/native:wpiutil",
    ],
)

wpilib_cc_static_library(
    name = "static/fieldimages",
    static_lib_name = select({
        "@platforms//os:windows": "static/fieldimages.lib",
        "//conditions:default": "static/libfieldimages.a",
    }),
    target_compatible_with = NO_SYSTEMCORE,
    visibility = ["//visibility:public"],
    deps = [
        ":fieldimages",
    ],
)

package_static_cc_project(
    name = "fieldimages",
    architectures = host_architectures,
    maven_artifact_name = "field-images-cpp",
    maven_group_id = "org.wpilib.fields",
)

package_default_cc_project(
    name = "fields",
    maven_artifact_name = "fields-cpp",
    maven_group_id = "org.wpilib.fields",
)
