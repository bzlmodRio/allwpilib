load("@rules_java//java/toolchains:java_package_configuration.bzl", "java_package_configuration")
load("@rules_jvm_external//:defs.bzl", "maven_export")
load("@rules_pkg//:pkg.bzl", "pkg_zip")

java_package_configuration(
    name = "toolchain_config",
    javacopts = [
        "-Xlint:-this-escape",
    ],
    packages = [":packages"],
    visibility = ["//visibility:public"],
)

package_group(
    name = "packages",
    packages = ["//wpilibjExamples/..."],
)

pkg_zip(
    name = "commands-zip",
    srcs = [
        "//:license_pkg_files",
        "//wpilibjExamples/src/main/java/org/wpilib/commands",
    ],
    tags = ["manual"],
)

pkg_zip(
    name = "snippets-zip",
    srcs = [
        "//:license_pkg_files",
        "//wpilibjExamples/src/main/java/org/wpilib/snippets",
    ],
    tags = ["manual"],
)

pkg_zip(
    name = "templates-zip",
    srcs = [
        "//:license_pkg_files",
        "//wpilibjExamples/src/main/java:main",
        "//wpilibjExamples/src/main/java/org/wpilib/templates",
    ],
    tags = ["manual"],
)

pkg_zip(
    name = "examples-zip",
    srcs = [
        "//:license_pkg_files",
        "//wpilibjExamples/src/main/java:main",
        "//wpilibjExamples/src/main/java/org/wpilib/examples",
        "//wpilibjExamples/src/test/java/org/wpilib/examples",
    ],
    tags = ["manual"],
)

maven_export(
    name = "examples_publish",
    maven_coordinates = "org.wpilib.wpilibj:examples:$(WPILIB_VERSION)",
    target = ":examples-zip",
    visibility = ["//visibility:public"],
)

maven_export(
    name = "commands_publish",
    maven_coordinates = "org.wpilib.wpilibj:commands:$(WPILIB_VERSION)",
    target = ":commands-zip",
    visibility = ["//visibility:public"],
)

maven_export(
    name = "templates_publish",
    maven_coordinates = "org.wpilib.wpilibj:templates:$(WPILIB_VERSION)",
    target = ":templates-zip",
    visibility = ["//visibility:public"],
)

maven_export(
    name = "snippets_publish",
    maven_coordinates = "org.wpilib.wpilibj:snippets:$(WPILIB_VERSION)",
    target = ":snippets-zip",
    visibility = ["//visibility:public"],
)
