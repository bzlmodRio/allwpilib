load("//shared/bazel/rules:cc_rules.bzl", "wpilib_cc_library", "wpilib_cc_shared_library", "wpilib_cc_static_library")
load("//shared/bazel/rules:packaging.bzl", "package_default_cc_project")

wpilib_cc_library(
    name = "catch2",
    srcs = glob(["cpp/**"]),
    hdrs = glob(["include/**"]),
    hdrs_pkg_root = "include",
    includes = ["include"],
    srcs_pkg_root = "cpp",
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

alias(
    name = "native",
    actual = ":catch2",
    visibility = ["//visibility:public"],
)

wpilib_cc_shared_library(
    name = "shared/catch2",
    use_debug_name = False,
    visibility = ["//visibility:public"],
    deps = [
        ":catch2",
    ],
)

wpilib_cc_static_library(
    name = "static/catch2",
    static_lib_name = select({
        "@platforms//os:windows": "static/catch2.lib",
        "//conditions:default": "static/libcatch2.a",
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":catch2",
    ],
)

package_default_cc_project(
    name = "catch2",
    maven_artifact_name = "catch2-cpp",
    maven_group_id = "org.wpilib.thirdparty.catch2",
)
