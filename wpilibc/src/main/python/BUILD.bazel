load("//shared/bazel/rules/robotpy:build_info_gen.bzl", "generate_robotpy_pybind_build_info")
load("//wpilibc/src/main/python:robotpy_build_info.bzl", "define_pybind_library", "wpilib_extension", "wpilib_simulation_extension")

PKG_CONFIG_DEPS = [
    "//datalog/src/main/native:native/datalog/robotpy-native-datalog.pc",
    "//datalog/src/main/python:robotpy-wpilog.generated_pkgcfg_files",
    "//hal/src/main/native:native/wpihal/robotpy-native-mrclib.pc",
    "//hal/src/main/native:native/wpihal/robotpy-native-wpihal.pc",
    "//hal/src/main/python:robotpy-hal.generated_pkgcfg_files",
    "//ntcore/src/main/native:native/ntcore/robotpy-native-ntcore.pc",
    "//ntcore/src/main/python:pyntcore.generated_pkgcfg_files",
    "//telemetry/src/main/native:native/telemetry/robotpy-native-telemetry.pc",
    "//telemetry/src/main/python:robotpy-telemetry.generated_pkgcfg_files",
    "//tunables/src/main/native:native/tunables/robotpy-native-tunables.pc",
    "//tunables/src/main/python:robotpy-tunables.generated_pkgcfg_files",
    "//wpilibc/src/main/native:native/wpilib/robotpy-native-wpilib.pc",
    "//wpimath/src/main/native:native/wpimath/robotpy-native-wpimath.pc",
    "//wpimath/src/main/python:robotpy-wpimath.generated_pkgcfg_files",
    "//wpinet/src/main/native:native/wpinet/robotpy-native-wpinet.pc",
    "//wpinet/src/main/python:robotpy-wpinet.generated_pkgcfg_files",
    "//wpiutil/src/main/native:native/wpiutil/robotpy-native-wpiutil.pc",
    "//wpiutil/src/main/python:robotpy-wpiutil.generated_pkgcfg_files",
]

generate_robotpy_pybind_build_info(
    name = "robotpy-wpilib-generator",
    additional_srcs = [
        "wpilib/src/rpy/AddressableLEDBuffer.h",
        "wpilib/src/rpy/Filesystem.h",
        "wpilib/src/rpy/Notifier.h",
        "wpilib/src/rpy/MotorControllerGroup.h",
    ] + ["//wpilibc/src/main/native:robotpy-native-wpilib.copy_headers"],
    package_root_file = "wpilib/__init__.py",
    pkgcfgs = PKG_CONFIG_DEPS,
    yaml_files = glob(["semiwrap/**/*.yml"]),
)

wpilib_extension(
    srcs = glob(["wpilib/src/**/*.cpp"]),
    extra_hdrs = glob([
        "wpilib/src/rpy/*.h",
        "wpilib/src/rpy/*.inc",
    ]),
    header_to_dat_deps = glob(["wpilib/src/**"]),
    includes = [
        "wpilib",
        "wpilib/src",
    ],
)

wpilib_simulation_extension(
    srcs = ["wpilib/simulation/simulation.cpp"],
    header_to_dat_deps = glob([
        "wpilib/src/rpy/*.h",
        "wpilib/src/rpy/*.inc",
    ]),
)

define_pybind_library(
    name = "robotpy-wpilib",
    extra_pybind_hdrs = glob(["**/*.h"]),
    pkgcfgs = PKG_CONFIG_DEPS,
)
