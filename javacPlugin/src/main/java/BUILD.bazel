load("@rules_java//java:defs.bzl", "java_plugin")
load("//shared/bazel/rules:java_rules.bzl", "wpilib_java_library")

wpilib_java_library(
    name = "javacPlugin",
    srcs = glob(["**/*.java"]),
    maven_artifact_name = "wpilibj-javac-plugin-java",
    maven_group_id = "org.wpilib",
    resources = ["//javacPlugin:resource_files"],
    visibility = ["//visibility:public"],
    deps = [
        "//wpiannotations/src/main/java:wpiannotations",
    ],
)

java_plugin(
    name = "plugin",
    visibility = ["//visibility:public"],
    deps = [
        ":javacPlugin",
    ],
)
